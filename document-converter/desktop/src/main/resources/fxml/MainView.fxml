<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.documentconverter.desktop.ui.screens.converter.MainController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Título da aplicação -->
    <Label text="Document Converter" styleClass="title-label">
        <font>
            <Font size="24" name="System Bold"/>
        </font>
    </Label>

    <Label text="Converta imagens e PDFs facilmente" styleClass="subtitle-label">
        <font>
            <Font size="12"/>
        </font>
    </Label>

    <!-- Separador visual -->
    <Label styleClass="separator-line" />

    <!-- Seção: Imagens selecionadas -->
    <Label text="Arquivos selecionados:" styleClass="section-label">
        <font>
            <Font size="13" name="System Bold"/>
        </font>
    </Label>

    <HBox spacing="10">
        <TextField fx:id="txtFileCount" editable="false" promptText="Nenhum arquivo selecionado"
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnSelectFiles" text="Selecionar Arquivos" onAction="#onSelectFiles"
                minWidth="140"/>
    </HBox>

    <!-- Lista de arquivos selecionados -->
    <ListView fx:id="lstFiles" maxHeight="120" VBox.vgrow="ALWAYS"/>

    <!-- Seção: Formato de saída -->
    <Label text="Formato de saída:" styleClass="section-label">
        <font>
            <Font size="13" name="System Bold"/>
        </font>
    </Label>

    <ComboBox fx:id="cmbOutputFormat" promptText="Selecione o formato de saída" maxWidth="Infinity"/>

    <!-- Seção: DPI (visível apenas para conversão PDF → imagem) -->
    <Label fx:id="lblDpi" text="Resolução (DPI):" styleClass="section-label" visible="false" managed="false">
        <font>
            <Font size="13" name="System Bold"/>
        </font>
    </Label>

    <ComboBox fx:id="cmbDpi" visible="false" managed="false" maxWidth="Infinity"/>

    <!-- Seção: Conversão -->
    <Label styleClass="separator-line" />

    <Button fx:id="btnConvert" text="Converter" onAction="#onConvert"
            minWidth="150" maxWidth="200" alignment="CENTER">
        <font>
            <Font size="14" name="System Bold"/>
        </font>
    </Button>

    <!-- Barra de progresso -->
    <ProgressBar fx:id="progressBar" maxWidth="Infinity"/>

    <!-- Mensagem de status -->
    <Label fx:id="lblStatus" text="Selecione uma ou mais imagens para começar."
           wrapText="true" maxWidth="Infinity" styleClass="status-label"/>

    <!-- Espaçador para alinhar conteúdo no topo -->
    <VBox VBox.vgrow="ALWAYS"/>

    <!-- Rodapé com versão -->
    <Label text="v1.0.0 (MVP)" styleClass="footer-label" alignment="CENTER" maxWidth="Infinity">
        <font>
            <Font size="10"/>
        </font>
    </Label>

</VBox>
