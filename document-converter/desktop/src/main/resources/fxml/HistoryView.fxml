<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.documentconverter.desktop.javafx.controller.HistoryController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnBack" text="← Voltar" onAction="#onBack" minWidth="80"/>
        <Label text="Histórico" styleClass="title-label">
            <font><Font size="20" name="System Bold"/></font>
        </Label>
    </HBox>

    <Label text="Últimas conversões realizadas" styleClass="subtitle-label"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Pesquisar por arquivo" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbOperationFilter" minWidth="150"/>
    </HBox>

    <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Data" prefWidth="82"/>
            <TableColumn fx:id="colTime" text="Hora" prefWidth="76"/>
            <TableColumn fx:id="colOperation" text="Tipo" prefWidth="105"/>
            <TableColumn fx:id="colSource" text="Origem" prefWidth="125"/>
            <TableColumn fx:id="colDestination" text="Destino" prefWidth="125"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="70"/>
        </columns>
    </TableView>

    <Label fx:id="lblStatus" text="0 registro(s) encontrado(s)."
           wrapText="true" maxWidth="Infinity" styleClass="status-label"/>

    <Label text="v1.0.0 (MVP)" styleClass="footer-label" alignment="CENTER" maxWidth="Infinity">
        <font><Font size="10"/></font>
    </Label>
</VBox>
