<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.documentconverter.desktop.ui.screens.home.MainMenuController"
      alignment="CENTER" styleClass="root">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Título -->
    <Label text="Document Converter" styleClass="title-label">
        <font>
            <Font size="28" name="System Bold"/>
        </font>
    </Label>

    <Label text="Escolha uma operação" styleClass="subtitle-label">
        <font>
            <Font size="14"/>
        </font>
    </Label>

    <!-- Espaçamento -->
    <VBox spacing="5" VBox.vgrow="ALWAYS"/>

    <!-- Botão: Imagem → PDF -->
    <Button fx:id="btnImageToPdf" text="📄  Imagem → PDF"
            onAction="#onImageToPdf" maxWidth="300" minHeight="50"
            styleClass="menu-button">
        <font>
            <Font size="16" name="System Bold"/>
        </font>
    </Button>

    <!-- Botão: PDF → Imagem -->
    <Button fx:id="btnPdfToImage" text="🖼️  PDF → Imagem"
            onAction="#onPdfToImage" maxWidth="300" minHeight="50"
            styleClass="menu-button">
        <font>
            <Font size="16" name="System Bold"/>
        </font>
    </Button>

    <!-- Botão: PDF → DOCX -->
    <Button fx:id="btnPdfToDocx" text="PDF → DOCX"
            onAction="#onPdfToDocx" maxWidth="300" minHeight="50"
            styleClass="menu-button">
        <font>
            <Font size="16" name="System Bold"/>
        </font>
    </Button>

    <!-- Botão: DOCX → PDF -->
    <Button fx:id="btnDocxToPdf" text="DOCX → PDF"
            onAction="#onDocxToPdf" maxWidth="300" minHeight="50"
            styleClass="menu-button">
        <font>
            <Font size="16" name="System Bold"/>
        </font>
    </Button>

    <!-- Botão: Histórico -->
    <Button fx:id="btnHistory" text="Histórico"
            onAction="#onHistory" maxWidth="300" minHeight="50"
            styleClass="menu-button">
        <font>
            <Font size="16" name="System Bold"/>
        </font>
    </Button>

    <!-- Espaçamento -->
    <VBox spacing="5" VBox.vgrow="ALWAYS"/>

    <!-- Barra de status inferior -->
    <Label text="v1.0.0 (MVP) • Converta imagens e PDFs facilmente"
           styleClass="footer-label" alignment="CENTER" maxWidth="Infinity">
        <font>
            <Font size="11"/>
        </font>
    </Label>

</VBox>
