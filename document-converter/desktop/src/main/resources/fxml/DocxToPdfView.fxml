<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.documentconverter.desktop.ui.screens.converter.DocxToPdfController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Voltar" onAction="#onBack" minWidth="80"/>
        <Label text="DOCX → PDF" styleClass="title-label">
            <font><Font size="20" name="System Bold"/></font>
        </Label>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Converta documentos Word em PDF usando LibreOffice" styleClass="subtitle-label"
               HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConfigureLibreOffice" text="Configurar LibreOffice"
                onAction="#onConfigureLibreOffice" minWidth="170"/>
    </HBox>

    <Label styleClass="separator-line"/>

    <Label text="Arquivo DOCX:" styleClass="section-label">
        <font><Font size="13" name="System Bold"/></font>
    </Label>

    <HBox spacing="10">
        <TextField fx:id="txtDocxFile" editable="false" promptText="Nenhum DOCX selecionado"
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnSelectDocx" text="Selecionar DOCX" onAction="#onSelectDocx"
                minWidth="130"/>
    </HBox>

    <VBox fx:id="dropZone" styleClass="drop-zone" alignment="CENTER" minHeight="90"
          VBox.vgrow="ALWAYS">
        <Label text="Arraste seu arquivo aqui" styleClass="drop-label"/>
        <Label text="ou clique para selecionar" styleClass="drop-hint"/>
    </VBox>

    <Label styleClass="separator-line"/>

    <Button fx:id="btnConvert" text="Converter para PDF" onAction="#onConvert"
            disable="true" minWidth="200" maxWidth="Infinity" alignment="CENTER">
        <font><Font size="14" name="System Bold"/></font>
    </Button>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnCancel" text="Cancelar" onAction="#onCancel"
                visible="false" managed="false" minWidth="100"/>
    </HBox>

    <ProgressBar fx:id="progressBar" maxWidth="Infinity"/>
    <Label fx:id="lblPercent" text="" alignment="CENTER" maxWidth="Infinity"
           styleClass="percent-label"/>
    <Label fx:id="lblStatus" text="Selecione um arquivo DOCX para começar."
           wrapText="true" maxWidth="Infinity" styleClass="status-label"/>

    <VBox VBox.vgrow="ALWAYS"/>

    <Label text="v1.0.0 (MVP)" styleClass="footer-label" alignment="CENTER" maxWidth="Infinity">
        <font><Font size="10"/></font>
    </Label>
</VBox>
