<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.documentconverter.desktop.javafx.controller.ImageToPdfController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Cabeçalho com botão Voltar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Voltar" onAction="#onBack" minWidth="80"/>
        <Label text="Imagem → PDF" styleClass="title-label">
            <font><Font size="20" name="System Bold"/></font>
        </Label>
    </HBox>

    <Label text="Converta imagens JPG, JPEG ou PNG em um PDF multipágina" styleClass="subtitle-label"/>

    <Label style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 5 0;"/>

    <!-- Arquivos selecionados -->
    <Label text="Arquivos selecionados:" styleClass="section-label">
        <font><Font size="13" name="System Bold"/></font>
    </Label>

    <HBox spacing="10">
        <TextField fx:id="txtFileCount" editable="false" promptText="Nenhum arquivo selecionado"
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnSelectFiles" text="Selecionar Imagens" onAction="#onSelectFiles"
                minWidth="140"/>
    </HBox>

    <!-- Área de Drop -->
    <VBox fx:id="dropZone" styleClass="drop-zone" alignment="CENTER" minHeight="80"
          VBox.vgrow="ALWAYS">
        <Label text="Arraste seus arquivos aqui" styleClass="drop-label"/>
        <Label text="ou clique para selecionar" styleClass="drop-hint"/>
    </VBox>

    <ListView fx:id="lstFiles" maxHeight="120" visible="false" managed="false"/>

    <Label style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 5 0;"/>

    <!-- Converter -->
    <Button fx:id="btnConvert" text="Converter para PDF" onAction="#onConvert"
            disable="true" minWidth="200" maxWidth="Infinity" alignment="CENTER">
        <font><Font size="14" name="System Bold"/></font>
    </Button>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnCancel" text="Cancelar" onAction="#onCancel"
                visible="false" managed="false" minWidth="100"/>
    </HBox>

    <ProgressBar fx:id="progressBar" maxWidth="Infinity"/>
    <Label fx:id="lblPercent" text="" alignment="CENTER" maxWidth="Infinity"
           styleClass="percent-label"/>
    <Label fx:id="lblStatus" text="Selecione uma ou mais imagens para começar."
           wrapText="true" maxWidth="Infinity" styleClass="status-label"/>

    <VBox VBox.vgrow="ALWAYS"/>

    <Label text="v1.0.0 (MVP)" styleClass="footer-label" alignment="CENTER" maxWidth="Infinity">
        <font><Font size="10"/></font>
    </Label>
</VBox>
